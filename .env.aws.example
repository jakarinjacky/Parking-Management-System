# Copy to .env on the EC2 server. Never commit the real file.
DB_PASSWORD=replace-with-a-long-random-password
PLATFORM_ADMIN_PASSWORD=replace-with-another-password-at-least-12-characters
APP_BIND_IP=0.0.0.0
APP_PORT=8080
# Change to true only after HTTPS is configured in front of the app.
PLATFORM_SECURE_COOKIE=false
